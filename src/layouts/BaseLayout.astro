---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 文章页传入，用于 og:article 元信息 */
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
  publishedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const site = Astro.site ?? new URL('https://sunightz.github.io');
// 产物是目录式的（/posts/x/index.html），canonical 统一带结尾斜杠，避免多一次跳转
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.author} />
    <meta
      name="keywords"
      content="Android, Shizuku, adb, 内核, GKI, C++, 逆向, SurfaceFlinger, Sunight"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!--
      主题初始化：必须在样式应用前同步执行，否则会出现「亮→暗」闪烁。
      默认跟随系统，用户在站点上的选择写入 localStorage 后优先生效。
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored
            ? stored === 'dark'
            : !window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Search />
    <BackToTop />
  </body>
</html>
