---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { published, tagCounts, tagSlug } from '../../utils';

const posts = published(await getCollection('blog'));
const tags = tagCounts(posts);
const totalTags = tags.length;
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">标签</h1>
      <p class="page-header__desc">共 {totalTags} 个标签，点击任意标签查看相关文章。</p>
    </header>

    {
      totalTags > 0 ? (
        <ul class="tag-cloud">
          {tags.map(({ tag, count }) => (
            <li>
              <a class="tag-cloud__item" href={`/tags/${tagSlug(tag)}/`}>
                {tag}
                <span class="tag-cloud__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>还没有标签。</p>
        </div>
      )
    }
  </div>
</BaseLayout>
