---
/**
 * 文章目录。只取 h2 / h3，depth 用字符串类型从页面传入，
 * 避免依赖 Astro 内部的 MarkdownHeading 类型导出。
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="文章目录">
      <p class="toc__title">目录</p>
      <ul>
        {items.map((h) => (
          <li class={h.depth === 3 ? 'toc__h3' : undefined}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // 滚动时高亮当前章节
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  if (links.length > 0) {
    const targets = links
      .map((a) => {
        const id = decodeURIComponent(a.hash.slice(1));
        const el = document.getElementById(id);
        return el ? { el, link: a } : null;
      })
      .filter((v): v is { el: HTMLElement; link: HTMLAnchorElement } => v !== null);

    let current: HTMLAnchorElement | null = null;

    const setActive = (link: HTMLAnchorElement) => {
      if (current === link) return;
      current?.classList.remove('is-active');
      link.classList.add('is-active');
      current = link;
    };

    const update = () => {
      const offset = window.innerHeight * 0.28;
      let active = targets[0];
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= offset) active = t;
      }
      if (active) setActive(active.link);
    };

    update();
    document.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
